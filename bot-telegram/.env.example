# Copia questo file in ".env" e metti i tuoi valori. Il file .env non va mai su GitHub.

# Token che ti dà BotFather
TELEGRAM_TOKEN=123456789:ABC...

# Chiave API di Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Chi può usare il bot: id Telegram separati da virgola (il bot ti dice il tuo id con /start).
# Lascia vuoto per non mettere limiti (sconsigliato).
UTENTI_AUTORIZZATI=

# Filtro sulle parole:
#   nessuno  = tiene tutto
#   comuni   = salta le parole molto comuni (und, der, ist, ich...)  [predefinito]
#   A2, B1, B2, C1 = tiene solo le parole da quel livello QCER in su
FILTRO=comuni

# File del database
DB_PATH=vocabolario.db
